# Research workspace — Valyu DeepResearch configuration
# Priority: CLI flags > VALYU_* env vars > [valyu] section below

# External services (dotenv / shell; not read by Valyu ConfigParser)
MINIMAX_API_KEY=your-minimax-api-key-here

[valyu]
api_key = your-valyu-api-key-here
# Comma-separated datasource categories; omit to search all sources
# Valid: research, healthcare, patents, markets, company, economic,
# predictions, legal, politics, cybersecurity, transportation
categories = research
# Optional batch settings
# batch_name = UniProt DR databases
# output_formats = markdown
# wait = false

[openalex]
# Both optional: research-verify works without them.
# A key raises the daily cap; mailto joins the polite pool.
api_key = your-openalex-api-key-here
mailto = you@example.com
